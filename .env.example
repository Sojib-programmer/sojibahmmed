# sojibahmmed.com — environment variables
#
# NOTE: The site no longer needs Supabase. The blog is fully static
# (src/pages/vision/blogData.ts + src/pages/vision/blogEssays.ts) and
# there is no database-backed content on this site anymore.
# The VITE_SUPABASE_* keys below are listed only as optional/unused
# placeholders for reference — leave them empty unless a future
# feature needs them. Do NOT copy real values from any .env file.

# --- Supabase (OPTIONAL / UNUSED — blog is static, no backend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Site ---
# Public base URL used for canonicals / OG tags.
VITE_SITE_URL=https://sojibahmmed.com
